      <column caption='Ocupacao_Combinada' datatype='integer' name='[Calculation_1337564217114624]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='ZN([quartos_ocupados]) + ZN([previsao_quartos_ocupados])' />
      </column>
      <column caption='Receita_Projetada' datatype='real' name='[Calculation_1337564217200641]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='IF ISNULL([adr]) THEN [Calculation_1337564217114624] * 1200 ELSE [Calculation_1337564217114624] * [adr] END' />
      </column>
      <column caption='RevPAR_Preditivo' datatype='real' name='[Calculation_1337564217266178]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='[Calculation_1337564217200641] / 300' />
      </column>
      <column caption='Alerta_Meta' datatype='string' name='[Calculation_1337564217397251]' role='measure' type='nominal'>
        <calculation class='tableau' formula='IF SUM([Calculation_1337564217200641]) &gt;= 500000 THEN &quot;Meta Batida&quot;&#13;&#10;ELSEIF SUM([Calculation_1337564217200641]) &gt;= 400000 THEN &quot;Atenção&quot;&#13;&#10;ELSE &quot;Risco Crítico&quot;&#13;&#10;END' />
      </column>
      <column caption='Taxa_Ocupacao_Projetada' datatype='real' name='[Calculation_1337564227833860]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='IF [id_resort] = &quot;SALINAS_MARAGOGI&quot; THEN [Calculation_1337564217114624] / 300&#13;&#10;ELSEIF [id_resort] = &quot;JAPARATINGA_LOUNGE&quot; THEN [Calculation_1337564217114624] / 300&#13;&#10;ELSE [Calculation_1337564217114624] / 600&#13;&#10;END' />
      </column>
      <column caption='Gatilho_Preco' datatype='string' name='[Calculation_1337564227911685]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='IF [Calculation_1337564227833860] &gt;= 0.10 THEN &quot;Demanda Aquecida: Sugestão de aumento de +12% na tarifa balcão&quot;&#13;&#10;     ELSEIF [Calculation_1337564227833860] &gt;= 0.05 THEN &quot;Demanda Firme: Sugestão de aumento de +5%&quot;&#13;&#10;     ELSEIF [Calculation_1337564227833860] &lt;= 0.02 THEN &quot;Baixa Procura: Avaliar Ação Promocional (-10%)&quot;&#13;&#10;     ELSE &quot;Tarifa Saudável: Manter Preço Atual&quot;&#13;&#10;     END' />
      </column>
